# Cafe Finder Environment Variables

# Server Port (default: 3000, auto-escalates if occupied)
PORT=3000

# Environment mode (development / production)
NODE_ENV=development

# PostgreSQL Database Connection String
# Leave blank to use local data/db.json file storage automatically
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafefinder

# Secret key used for signing session auth tokens (replace with a long random string in production)
SESSION_SECRET=cafe-finder-super-secret-key-change-in-production-2026

# Places provider: "osm" (OpenStreetMap Overpass - free, default) or "google" (Google Places)
PLACES_PROVIDER=osm

# Google Places API key (optional, only needed if PLACES_PROVIDER=google)
# GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
